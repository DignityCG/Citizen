<script>
let cur='s-splash';
const navMap={'s-home':0,'s-leaders':1,'s-elections':2,'s-report':3,'s-more':4};

function goTo(id){
  if(cur===id)return;
  const prev=document.getElementById(cur);
  const next=document.getElementById(id);
  if(!next)return;
  prev.classList.remove('active');prev.classList.add('exit');
  setTimeout(()=>prev.classList.remove('exit'),320);
  next.classList.add('active');
  cur=id;
  document.querySelectorAll('.sbtn').forEach(b=>b.classList.remove('active'));
  const sb=document.getElementById('btn-'+id);
  if(sb)sb.classList.add('active');
  const bnav=document.getElementById('bnav');
  if(id==='s-splash'||id==='s-onboard'){bnav.style.display='none';}
  else{
    bnav.style.display='flex';
    document.querySelectorAll('.ni').forEach(n=>n.classList.remove('active'));
    const ni=navMap[id];
    if(ni!==undefined){document.querySelectorAll('.ni')[ni].classList.add('active');}
    else{document.querySelectorAll('.ni')[4].classList.add('active');}
  }
  // scroll to top
  next.scrollTop=0;
}

function navTo(id,el){
  document.querySelectorAll('.ni').forEach(n=>n.classList.remove('active'));
  el.classList.add('active');
  goTo(id);
}

// Onboarding steps
function obNext(step){
  document.querySelectorAll('.ob-step').forEach(s=>s.classList.remove('active'));
  document.getElementById('ob'+step).classList.add('active');
  ['pip1','pip2','pip3'].forEach((p,i)=>{
    const el=document.getElementById(p);
    el.classList.remove('done','active');
    if(i<step-1)el.classList.add('done');
    else if(i===step-1)el.classList.add('active');
  });
}

// Language toggle
function toggleAllLangs(){
  const chips=document.querySelectorAll('.lchip');
  const allSel=[...chips].every(c=>c.classList.contains('sel'));
  chips.forEach(c=>{allSel?c.classList.remove('sel'):c.classList.add('sel')});
}

// Push dismiss
function dismissPush(){
  const p=document.getElementById('push-notif');
  if(p){p.style.animation='none';p.style.opacity='0';p.style.transform='translateY(-100%)';p.style.transition='all .3s';setTimeout(()=>p.remove(),300);}
}
setTimeout(()=>{const p=document.getElementById('push-notif');if(p)dismissPush();},6000);

// Voice bar
function toggleVoice(){
  const v=document.getElementById('vbar');
  v.classList.toggle('open');
  document.getElementById('vbar-ph').textContent=v.classList.contains('open')?'"How much on roads in Eti-Osa this year?"':'Ask Citizen anything…';
}

// Leader tabs
function switchLeaderTab(el,id){
  document.querySelectorAll('.ltab').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.ltab-content').forEach(c=>c.classList.remove('active'));
  el.classList.add('active');
  document.getElementById(id).classList.add('active');
}

// Report submit / reset
function submitReport(){
  document.getElementById('rform').style.display='none';
  document.getElementById('success-state').classList.add('show');
}
function resetReport(){
  document.getElementById('rform').style.display='block';
  document.getElementById('success-state').classList.remove('show');
}

// Star rating
function rateStar(el,idx){
  const row=el.parentElement;
  const stars=[...row.querySelectorAll('.rm-star')];
  stars.forEach((s,i)=>{s.classList.toggle('lit',i<=idx)});
}

// Quiz answer
function markAnswer(el,correct){
  document.querySelectorAll('.qopt').forEach(o=>{o.disabled=true;o.style.cursor='default'});
  el.classList.add(correct?'correct':'wrong');
  if(!correct)document.querySelectorAll('.qopt')[1].classList.add('correct');
  document.getElementById('qresult').classList.add('show');
}

// Topic switch
function switchTopic(el){
  document.querySelectorAll('.tcat').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
}

// Tax period toggle
const taxData={
  'MTD':{label:'Total tax paid · March 2026',total:'₦57,300',paye:'₦51.2K',gig:'₦5.1K',vat:'₦1.0K'},
  'YTD':{label:'Total tax paid · Jan–Mar 2026',total:'₦847,200',paye:'₦612K',gig:'₦185K',vat:'₦50K'},
  'LY':{label:'Total tax paid · Full year 2025',total:'₦2,844,000',paye:'₦2.2M',gig:'₦524K',vat:'₦120K'},
  'ALL':{label:'Total tax paid · All time (2019–2026)',total:'₦11,230,400',paye:'₦8.9M',gig:'₦1.8M',vat:'₦530K'}
};
function switchPeriod(el,key){
  document.querySelectorAll('.tpt').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
