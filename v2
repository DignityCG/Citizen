// Budget year toggle
const budgetData={
  '2024':{val:'₦36.5 Trillion',change:'▲ 21.2% vs 2023 (₦30.1T)'},
  '2025':{val:'₦47.9 Trillion',change:'▲ 31.4% vs 2024 (₦36.5T)'},
  '2026':{val:'₦54.2 Trillion',change:'▲ 13.2% vs 2025 (₦47.9T)'}
};
function switchBudget(el,yr){
  document.querySelectorAll('.byt').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('budget-val').textContent=budgetData[yr].val;
  document.getElementById('budget-change').textContent=budgetData[yr].change;
}

// Receipt modal
function openReceipt(){document.getElementById('receipt-modal').classList.add('open')}
function closeReceipt(){document.getElementById('receipt-modal').classList.remove('open')}

// Election countdown
function updateCountdown(){
  const d=Math.floor((new Date('2027-02-20')-new Date())/86400000);
  const el1=document.getElementById('el-days');
  const el2=document.getElementById('days-left');
  if(el1)el1.textContent=d;
  if(el2)el2.textContent=d;
}
updateCountdown();
setInterval(updateCountdown,60000);
</script>
