<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Citizen NG v2 — by Dignity</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --ng-green:#008751; --ng-green-d:#005c37; --ng-green-l:#00b368; --ng-green-f:rgba(0,135,81,0.1);
  --gold:#D4A017; --gold-l:#F5C842; --gold-f:rgba(212,160,23,0.1);
  --ink:#0D1117; --ink2:#1A2332; --ink3:#243040;
  --s1:#131C27; --s2:#1C2A3A; --s3:#243347; --s4:#2C3E54;
  --b1:rgba(255,255,255,0.07); --b2:rgba(255,255,255,0.13); --b3:rgba(255,255,255,0.2);
  --t1:#F0F4F8; --t2:#9BADC0; --t3:#5A7085; --t4:#364D63;
  --red:#E53E3E; --red-f:rgba(229,62,62,0.1);
  --orange:#ED8936; --orange-f:rgba(237,137,54,0.1);
  --blue:#4299E1; --blue-f:rgba(66,153,225,0.1);
  --purple:#9F7AEA; --purple-f:rgba(159,122,234,0.1);
  --fd:'Playfair Display',serif; --fb:'DM Sans',sans-serif; --fm:'DM Mono',monospace;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{background:#060C14;font-family:var(--fb);color:var(--t1);min-height:100vh;display:flex;align-items:flex-start;justify-content:center;padding:20px;gap:40px}

/* ── PHONE ─────────────────────────────────── */
.phone-wrap{flex-shrink:0;position:sticky;top:20px}
.phone{width:375px;height:780px;background:var(--ink);border-radius:48px;border:2px solid rgba(255,255,255,0.1);box-shadow:0 0 0 6px #060C14,0 0 0 8px rgba(255,255,255,0.04),0 50px 100px rgba(0,0,0,0.9),0 0 80px rgba(0,135,81,0.06);overflow:hidden;position:relative;display:flex;flex-direction:column}
.sbar{display:flex;justify-content:space-between;align-items:center;padding:14px 24px 0;flex-shrink:0}
.sbar-time{font-family:var(--fm);font-size:13px;color:var(--t1);font-weight:500}
.sbar-icons{display:flex;gap:5px;align-items:center}
.screens{flex:1;position:relative;overflow:hidden}
.screen{position:absolute;inset:0;overflow-y:auto;overflow-x:hidden;scrollbar-width:none;opacity:0;pointer-events:none;transform:translateX(28px);transition:opacity .3s cubic-bezier(.4,0,.2,1),transform .3s cubic-bezier(.4,0,.2,1)}
.screen::-webkit-scrollbar{display:none}
.screen.active{opacity:1;pointer-events:all;transform:translateX(0)}
.screen.exit{opacity:0;transform:translateX(-28px)}

/* ── BOTTOM NAV ─────────────────────────────── */
.bnav{flex-shrink:0;display:flex;background:rgba(13,17,23,0.97);border-top:1px solid var(--b1);padding:8px 0 20px;z-index:50;backdrop-filter:blur(20px)}
.ni{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;cursor:pointer;padding:5px 0;transition:all .2s;border:none;background:none;color:var(--t4)}
.ni.active{color:var(--ng-green-l)}
.ni svg{width:21px;height:21px;stroke-width:1.8}
.ni-label{font-size:10px;font-weight:500;letter-spacing:.02em}
.ni-dot{width:3px;height:3px;border-radius:50%;background:var(--ng-green-l);margin-top:1px;opacity:0;transition:opacity .2s}
.ni.active .ni-dot{opacity:1}

/* ── SIDEBAR ─────────────────────────────────── */
.sidebar{flex:1;min-width:0;max-width:480px;padding-top:4px}
.sb-title{font-family:var(--fd);font-size:26px;margin-bottom:5px;line-height:1.2}
.sb-sub{font-size:13px;color:var(--t2);margin-bottom:4px;line-height:1.6}
.sb-badge{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;background:var(--ng-green-f);border:1px solid rgba(0,135,81,0.3);border-radius:20px;font-size:11px;color:var(--ng-green-l);font-weight:500;margin-bottom:20px}
.snav{display:flex;flex-direction:column;gap:6px}
.sbtn{display:flex;align-items:center;gap:12px;padding:12px 16px;background:var(--s1);border:1px solid var(--b1);border-radius:12px;cursor:pointer;transition:all .2s;color:var(--t2);font-family:var(--fb);font-size:13px;text-align:left;width:100%}
.sbtn:hover{background:var(--s2);border-color:var(--b2);color:var(--t1)}
.sbtn.active{background:var(--ng-green-f);border-color:var(--ng-green);color:var(--ng-green-l)}
.sbtn-num{width:24px;height:24px;border-radius:7px;background:var(--s2);display:flex;align-items:center;justify-content:center;font-family:var(--fm);font-size:10px;flex-shrink:0}
.sbtn.active .sbtn-num{background:var(--ng-green);color:#fff}
.sbtn-text{flex:1}
.sbtn-label{font-weight:500}
.sbtn-desc{font-size:11px;color:var(--t3);margin-top:1px}
.sbtn.active .sbtn-desc{color:rgba(0,179,104,.6)}
.sbtn-new{font-size:9px;padding:1px 6px;background:var(--gold-f);border:1px solid rgba(212,160,23,.3);border-radius:8px;color:var(--gold-l);font-weight:600;letter-spacing:.05em}

/* ── SHARED COMPONENTS ──────────────────────── */
.btn-p{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:15px;background:var(--ng-green);color:#fff;border:none;border-radius:14px;font-family:var(--fb);font-size:15px;font-weight:600;cursor:pointer;transition:all .2s;margin-bottom:10px}
.btn-p:hover{background:var(--ng-green-l);transform:translateY(-1px)}
.btn-s{display:flex;align-items:center;justify-content:center;width:100%;padding:13px;background:transparent;color:var(--t2);border:1px solid var(--b2);border-radius:14px;font-family:var(--fb);font-size:14px;cursor:pointer;transition:all .2s}
.btn-s:hover{background:var(--s1);color:var(--t1)}
.pill{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:20px;font-size:10px;font-weight:600}
.pill-g{background:rgba(0,135,81,.15);color:var(--ng-green-l)}
.pill-o{background:var(--orange-f);color:var(--orange)}
.pill-r{background:var(--red-f);color:var(--red)}
.pill-b{background:var(--blue-f);color:var(--blue)}
.pill-p{background:var(--purple-f);color:var(--purple)}
.pill-gold{background:var(--gold-f);color:var(--gold-l)}
.sec-hd{display:flex;justify-content:space-between;align-items:center;padding:0 20px;margin-bottom:10px}
.sec-title{font-size:11px;font-weight:600;color:var(--t3);letter-spacing:.08em;text-transform:uppercase}
.sec-link{font-size:12px;color:var(--ng-green-l);cursor:pointer;font-weight:500}
.card{background:var(--s1);border:1px solid var(--b1);border-radius:16px;overflow:hidden}
.divider{height:1px;background:var(--b1);margin:0}
.screen-header{padding:18px 20px 12px}
.screen-title{font-family:var(--fd);font-size:24px;color:var(--t1);margin-bottom:3px}
.screen-sub{font-size:13px;color:var(--t2);line-height:1.5}
.fi{display:block;font-size:12px;font-weight:500;color:var(--t3);letter-spacing:.07em;text-transform:uppercase;margin-bottom:5px}
.finput{width:100%;padding:12px 14px;background:var(--s2);border:1px solid var(--b1);border-radius:11px;color:var(--t1);font-family:var(--fb);font-size:14px;outline:none;transition:border-color .2s}
.finput:focus{border-color:var(--ng-green)}
.fselect{width:100%;padding:12px 14px;background:var(--s2);border:1px solid var(--b1);border-radius:11px;color:var(--t1);font-family:var(--fb);font-size:14px;outline:none;appearance:none;-webkit-appearance:none;cursor:pointer}
.selwrap{position:relative}
.selwrap::after{content:'▾';position:absolute;right:14px;top:50%;transform:translateY(-50%);color:var(--t3);pointer-events:none;font-size:11px}
.fgroup{margin-bottom:14px}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(.8)}}
@keyframes slidein{from{transform:translateY(-100%);opacity:0}to{transform:translateY(0);opacity:1}}
@keyframes fadeup{from{transform:translateY(10px);opacity:0}to{transform:translateY(0);opacity:1}}

/* ═══════════════════════════════════════════
   S1 — SPLASH (improved)
═══════════════════════════════════════════ */
#s-splash{background:linear-gradient(160deg,#091510 0%,#0D1117 65%);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px 28px;overflow:hidden;position:relative}
.sp-ring{position:absolute;border-radius:50%;border:1px solid var(--ng-green);pointer-events:none}
.sp-flag{display:flex;gap:5px;margin-bottom:28px}
.sp-bar{width:16px;height:54px;border-radius:3px}
.sp-bar.g{background:var(--ng-green)}
.sp-bar.w{background:rgba(255,255,255,.88)}
.sp-logo{font-family:var(--fd);font-size:52px;font-weight:900;color:var(--t1);letter-spacing:-1px;line-height:1;margin-bottom:5px}
.sp-logo span{color:var(--ng-green-l)}
.sp-by{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--t4);margin-bottom:14px;font-weight:500}
.sp-tag{font-size:17px;color:var(--t2);line-height:1.6;margin-bottom:36px;max-width:260px;font-style:italic;font-family:var(--fd)}
.sp-tag em{color:var(--ng-green-l);font-style:normal}
.sp-sso{display:flex;align-items:center;gap:10px;padding:13px 18px;background:var(--ng-green-f);border:1px solid rgba(0,135,81,.3);border-radius:14px;margin-bottom:10px;cursor:pointer;transition:all .2s;width:100%}
.sp-sso:hover{background:rgba(0,135,81,.15);border-color:rgba(0,135,81,.5)}
.sp-sso-icon{width:32px;height:32px;background:var(--ng-green);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
.sp-sso-text{text-align:left;flex:1}
.sp-sso-title{font-size:13px;font-weight:600;color:var(--ng-green-l)}
.sp-sso-sub{font-size:11px;color:var(--t3);margin-top:1px}
.sp-divtext{font-size:11px;color:var(--t4);margin:8px 0;text-align:center}

/* ═══════════════════════════════════════════
   S2 — ONBOARDING (3 steps fixed)
═══════════════════════════════════════════ */
#s-onboard{background:var(--ink);padding:20px 22px 28px}
.ob-steps{display:flex;gap:5px;margin-bottom:20px}
.ob-pip{height:3px;border-radius:2px;flex:1;background:var(--s3);transition:background .3s}
.ob-pip.done{background:var(--ng-green)}
.ob-pip.active{background:var(--ng-green-l)}
.ob-title{font-family:var(--fd);font-size:24px;color:var(--t1);margin-bottom:5px;line-height:1.25}
.ob-sub{font-size:13px;color:var(--t2);line-height:1.5;margin-bottom:20px}
.ob-step{display:none}
.ob-step.active{display:block;animation:fadeup .3s ease}
.lang-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.lchip{padding:10px 12px;background:var(--s2);border:1px solid var(--b1);border-radius:9px;font-size:12px;color:var(--t2);cursor:pointer;transition:all .2s;text-align:center;font-weight:500}
.lchip.sel{background:var(--ng-green-f);border-color:var(--ng-green);color:var(--ng-green-l)}
.lang-all{text-align:center;font-size:12px;color:var(--ng-green-l);cursor:pointer;margin-bottom:10px;font-weight:500}
.ob-nav{display:flex;gap:8px;margin-top:20px}
.ob-back{flex:0 0 48px;padding:13px;background:var(--s2);border:1px solid var(--b1);border-radius:12px;color:var(--t2);cursor:pointer;font-size:18px;font-family:var(--fb)}

/* ═══════════════════════════════════════════
   S3 — HOME (improved)
═══════════════════════════════════════════ */
#s-home{background:var(--ink);padding:0}
.push-notif{position:absolute;top:8px;left:16px;right:16px;z-index:100;background:var(--s2);border:1px solid var(--b2);border-radius:14px;padding:12px 14px;display:flex;gap:12px;align-items:flex-start;animation:slidein .4s cubic-bezier(.34,1.56,.64,1);box-shadow:0 8px 32px rgba(0,0,0,.6);cursor:pointer}
.push-app{width:32px;height:32px;background:var(--ng-green);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0}
.push-title{font-size:12px;font-weight:600;color:var(--t1);margin-bottom:2px}
.push-body{font-size:11px;color:var(--t2);line-height:1.4}
.push-dismiss{position:absolute;top:8px;right:10px;font-size:16px;color:var(--t3);cursor:pointer;background:none;border:none;color:var(--t3);font-size:14px;line-height:1}
.home-hd{background:linear-gradient(180deg,#091510 0%,var(--ink) 100%);padding:14px 18px 18px;position:relative;overflow:hidden}
.home-hd::before{content:'';position:absolute;top:-50px;right:-50px;width:200px;height:200px;border-radius:50%;background:radial-gradient(circle,rgba(0,135,81,.12) 0%,transparent 70%);pointer-events:none}
.gps-pill{display:inline-flex;align-items:center;gap:5px;padding:5px 11px;background:var(--ng-green-f);border:1px solid rgba(0,135,81,.3);border-radius:20px;font-size:11px;color:var(--ng-green-l);font-weight:500;margin-bottom:10px}
.gps-dot{width:5px;height:5px;border-radius:50%;background:var(--ng-green-l);animation:pulse 2s infinite}
.home-greet{font-family:var(--fd);font-size:20px;color:var(--t1);margin-bottom:3px;line-height:1.2}
.home-sub2{font-size:12px;color:var(--t2)}

/* Voice bar — active with AI response */
.vbar{margin:14px 18px 0;padding:13px 16px;background:var(--s1);border:1px solid var(--b1);border-radius:14px;cursor:pointer;transition:all .2s}
.vbar:hover,.vbar.open{border-color:var(--ng-green);background:var(--s2)}
.vbar-top{display:flex;align-items:center;gap:10px}
.vbar-mic{width:34px;height:34px;border-radius:9px;background:var(--ng-green-f);border:1px solid rgba(0,135,81,.3);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.vbar-ph{font-size:13px;color:var(--t3);flex:1}
.vbar-hint{font-size:11px;color:var(--t3)}
.vbar-response{margin-top:10px;padding-top:10px;border-top:1px solid var(--b1);display:none;animation:fadeup .3s ease}
.vbar.open .vbar-response{display:block}
.vbar-q{font-size:11px;color:var(--t3);margin-bottom:6px;font-style:italic}
.vbar-a{font-size:13px;color:var(--t1);line-height:1.6}
.vbar-a em{color:var(--ng-green-l);font-style:normal;font-weight:500}
.vbar-chips{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}
.vbar-chip{padding:4px 10px;background:var(--s3);border:1px solid var(--b1);border-radius:20px;font-size:11px;color:var(--t2);cursor:pointer;transition:all .15s}
.vbar-chip:hover{border-color:var(--ng-green);color:var(--ng-green-l)}

.alert-strip{margin:10px 18px;padding:12px 14px;background:var(--orange-f);border:1px solid rgba(237,137,54,.3);border-radius:12px;display:flex;gap:10px;align-items:flex-start;cursor:pointer}
.as-icon{font-size:16px;flex-shrink:0;margin-top:1px}
.as-title{font-size:12px;font-weight:600;color:var(--orange);margin-bottom:2px}
.as-body{font-size:11px;color:var(--t2);line-height:1.4}

.qgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:0 18px;margin-bottom:18px}
.qcard{padding:14px;background:var(--s1);border:1px solid var(--b1);border-radius:14px;cursor:pointer;transition:all .2s;position:relative;overflow:hidden}
.qcard:hover{background:var(--s2);border-color:var(--b2);transform:translateY(-2px)}
.qcard-accent{height:2px;border-radius:2px;margin-bottom:10px}
.qcard-icon{font-size:20px;margin-bottom:6px}
.qcard-label{font-size:12px;font-weight:600;color:var(--t1);margin-bottom:2px}
.qcard-val{font-size:11px;color:var(--t3)}

.faac-card{margin:0 18px 16px;padding:16px;background:var(--s1);border:1px solid var(--b1);border-radius:14px}
.faac-ttl{font-size:11px;color:var(--t3);letter-spacing:.08em;text-transform:uppercase;font-weight:500;margin-bottom:10px}
.faac-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.faac-label{font-size:12px;color:var(--t2)}
.faac-amt{font-family:var(--fm);font-size:12px;color:var(--ng-green-l);font-weight:500}
.faac-track{height:3px;background:var(--s3);border-radius:2px;margin-top:4px;margin-bottom:8px}
.faac-fill{height:3px;border-radius:2px;background:var(--ng-green)}

/* ═══════════════════════════════════════════
   S4 — LEADERS (tabs working)
═══════════════════════════════════════════ */
#s-leaders{background:var(--ink);padding:0}
.ltabs{display:flex;gap:5px;padding:0 18px;margin-bottom:14px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px}
.ltabs::-webkit-scrollbar{display:none}
.ltab{padding:6px 13px;border-radius:20px;font-size:11px;font-weight:500;white-space:nowrap;cursor:pointer;border:1px solid var(--b1);color:var(--t3);background:transparent;transition:all .2s;font-family:var(--fb)}
.ltab.active{background:var(--ng-green);color:#fff;border-color:var(--ng-green)}
.ltab-content{display:none;padding:0 18px 20px;animation:fadeup .25s ease}
.ltab-content.active{display:block}

.lcard{background:var(--s1);border:1px solid var(--b1);border-radius:16px;margin-bottom:10px;overflow:hidden;cursor:pointer;transition:all .2s}
.lcard:hover{border-color:var(--b2);transform:translateY(-1px)}
.lcard-top{padding:14px;display:flex;gap:12px;align-items:flex-start}
.lcard-av{width:46px;height:46px;border-radius:12px;background:var(--s3);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;border:1px solid var(--b1)}
.lcard-name{font-size:14px;font-weight:600;color:var(--t1);margin-bottom:2px}
.lcard-role{font-size:11px;color:var(--t3);margin-bottom:7px}
.lcard-contacts{display:flex;gap:6px;flex-wrap:wrap}
.contact-btn{display:inline-flex;align-items:center;gap:4px;padding:4px 9px;background:var(--s2);border:1px solid var(--b1);border-radius:8px;font-size:11px;color:var(--ng-green-l);cursor:pointer;transition:all .2s;font-weight:500}
.contact-btn:hover{background:var(--ng-green-f);border-color:var(--ng-green)}
.lcard-stats{padding:10px 14px;border-top:1px solid var(--b1);display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.lstat{text-align:center}
.lstat-val{font-family:var(--fm);font-size:13px;font-weight:500;color:var(--t1)}
.lstat-key{font-size:10px;color:var(--t3);margin-top:1px}
.lcard-meter{padding:10px 14px;border-top:1px solid var(--b1)}
.meter-row{display:flex;align-items:center;gap:8px;margin-bottom:7px}
.meter-row:last-child{margin-bottom:0}
.meter-label{font-size:11px;color:var(--t2);flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.meter-track{flex:2;height:4px;background:var(--s3);border-radius:2px}
.meter-fill{height:4px;border-radius:2px}
.meter-val{font-family:var(--fm);font-size:10px;color:var(--t2);width:28px;text-align:right;flex-shrink:0}

/* NASS scorecard */
.nass-card{background:var(--s1);border:1px solid var(--b1);border-radius:16px;margin-bottom:10px;overflow:hidden}
.nass-hd{padding:12px 14px;background:var(--s2);border-bottom:1px solid var(--b1);display:flex;align-items:center;gap:10px}
.nass-av{width:40px;height:40px;border-radius:10px;background:var(--ng-green-f);display:flex;align-items:center;justify-content:center;font-size:18px;border:1px solid rgba(0,135,81,.3)}
.nass-name{font-size:13px;font-weight:600;color:var(--t1)}
.nass-role{font-size:11px;color:var(--t3)}
.nass-metrics{padding:12px 14px;display:grid;grid-template-columns:1fr 1fr;gap:8px}
.nm{padding:10px;background:var(--s2);border-radius:10px;text-align:center}
.nm-val{font-family:var(--fm);font-size:16px;font-weight:500;color:var(--t1)}
.nm-key{font-size:10px;color:var(--t3);margin-top:2px}
.nass-attend{padding:10px 14px;border-top:1px solid var(--b1)}
.attend-label{font-size:11px;color:var(--t3);margin-bottom:5px}
.attend-track{height:5px;background:var(--s3);border-radius:3px}
.attend-fill{height:5px;border-radius:3px;background:var(--ng-green)}
.attend-val{font-size:11px;color:var(--ng-green-l);margin-top:4px;font-family:var(--fm)}

/* Leaderboard */
.lb{background:var(--s1);border:1px solid var(--b1);border-radius:14px;overflow:hidden;margin-bottom:10px}
.lb-hd{padding:10px 14px;background:var(--s2);border-bottom:1px solid var(--b1);font-size:11px;font-weight:600;color:var(--t3);letter-spacing:.07em;text-transform:uppercase}
.lb-row{padding:10px 14px;display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--b1);cursor:pointer;transition:background .15s}
.lb-row:hover{background:var(--s2)}
.lb-row:last-child{border-bottom:none}
.lb-row.you{background:rgba(212,160,23,.04);border-left:2px solid var(--gold)}
.lb-rank{width:22px;font-family:var(--fm);font-size:11px;color:var(--t3);flex-shrink:0}
.lb-rank.g1{color:var(--gold-l);font-weight:600}
.lb-rank.g2{color:#C0C0C0;font-weight:600}
.lb-rank.g3{color:#CD7F32;font-weight:600}
.lb-name{flex:1}
.lb-n{font-size:12px;font-weight:500;color:var(--t1)}
.lb-area{font-size:10px;color:var(--t3);margin-top:1px}
.lb-score{font-family:var(--fm);font-size:12px;color:var(--ng-green-l);font-weight:500}

/* ═══════════════════════════════════════════
   S5 — REPORTING (fixed)
═══════════════════════════════════════════ */
#s-report{background:var(--ink);padding:0}
.rcat-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:0 18px;margin-bottom:18px}
.rcat{padding:14px;background:var(--s1);border:1px solid var(--b1);border-radius:14px;cursor:pointer;transition:all .2s;text-align:center}
.rcat:hover{background:var(--s2);border-color:var(--b2)}
.rcat.whistle{background:var(--purple-f);border-color:rgba(159,122,234,.3)}
.rcat.positive{background:var(--ng-green-f);border-color:rgba(0,135,81,.3)}
.rcat-icon{font-size:22px;margin-bottom:6px}
.rcat-label{font-size:12px;font-weight:600;color:var(--t1);margin-bottom:2px}
.rcat-count{font-size:10px;color:var(--t3)}

.rform{margin:0 18px 16px;padding:18px;background:var(--s1);border:1px solid var(--b1);border-radius:16px}
.rform-title{font-size:14px;font-weight:600;color:var(--t1);margin-bottom:14px}
.ftextarea{width:100%;padding:12px 14px;background:var(--s2);border:1px solid var(--b1);border-radius:11px;color:var(--t1);font-family:var(--fb);font-size:13px;outline:none;resize:none;height:90px;line-height:1.5;margin-bottom:10px}
.ftextarea:focus{border-color:var(--ng-green)}
.media-row{display:flex;gap:6px;margin-bottom:10px}
.mbtn{flex:1;padding:9px;background:var(--s2);border:1px dashed var(--b2);border-radius:9px;color:var(--t3);font-size:11px;font-weight:500;cursor:pointer;text-align:center;transition:all .2s;font-family:var(--fb)}
.mbtn:hover{border-color:var(--ng-green);color:var(--ng-green-l)}

/* Success state */
.success-state{display:none;text-align:center;padding:20px;animation:fadeup .3s ease}
.success-state.show{display:block}
.success-icon{font-size:40px;margin-bottom:10px}
.success-title{font-size:16px;font-weight:600;color:var(--ng-green-l);margin-bottom:5px}
.success-ref{font-family:var(--fm);font-size:12px;color:var(--t3);margin-bottom:8px}
.success-body{font-size:13px;color:var(--t2);line-height:1.5}

/* Report feed */
.ri{padding:12px 18px;display:flex;gap:10px;align-items:flex-start;border-bottom:1px solid var(--b1);cursor:pointer;transition:background .15s}
.ri:hover{background:var(--s1)}
.ri:last-child{border-bottom:none}
.ri-dot{width:7px;height:7px;border-radius:50%;margin-top:4px;flex-shrink:0}
.ri-dot.pend{background:var(--orange)}
.ri-dot.res{background:var(--ng-green-l)}
.ri-dot.act{background:var(--blue)}
.ri-title{font-size:13px;font-weight:500;color:var(--t1);margin-bottom:2px}
.ri-meta{font-size:11px;color:var(--t3)}

/* ═══════════════════════════════════════════
   S6 — ELECTIONS
═══════════════════════════════════════════ */
#s-elections{background:var(--ink);padding:0}
.elec-hero{background:linear-gradient(135deg,#0c1a0f,#150a0a);border-bottom:1px solid var(--b1);padding:18px;position:relative;overflow:hidden;text-align:center}
.elec-hero::before{content:'';position:absolute;top:-40px;left:50%;transform:translateX(-50%);width:220px;height:220px;border-radius:50%;background:radial-gradient(circle,rgba(212,160,23,.07) 0%,transparent 70%);pointer-events:none}
.elec-flag{font-size:28px;margin-bottom:6px}
.elec-title{font-family:var(--fd);font-size:20px;color:var(--gold-l);margin-bottom:3px}
.elec-sub{font-size:12px;color:var(--t2);margin-bottom:14px}
.cd-row{display:flex;justify-content:center;gap:20px;margin-bottom:14px}
.cd-blk{text-align:center}
.cd-num{font-family:var(--fm);font-size:26px;font-weight:500;color:var(--gold-l);line-height:1}
.cd-lbl{font-size:9px;color:var(--t3);margin-top:2px;letter-spacing:.1em;text-transform:uppercase}

/* Debate card */
.debate-card{margin:14px 18px;padding:16px;background:linear-gradient(135deg,#0e1c2e,#0a1a0f);border:1px solid rgba(0,135,81,.25);border-radius:16px}
.debate-live-badge{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;background:var(--red-f);border:1px solid rgba(229,62,62,.3);border-radius:20px;font-size:9px;font-weight:600;color:var(--red);letter-spacing:.1em;text-transform:uppercase;margin-bottom:8px}
.live-dot{width:5px;height:5px;border-radius:50%;background:var(--red);animation:pulse 1.5s infinite}
.debate-title{font-size:14px;font-weight:600;color:var(--t1);margin-bottom:3px}
.debate-meta{font-size:11px;color:var(--t2);margin-bottom:12px}
.debate-cands{display:flex;gap:6px;margin-bottom:12px}
.dc{flex:1;padding:8px;background:rgba(0,0,0,.2);border-radius:8px;text-align:center}
.dc-av{font-size:18px;margin-bottom:3px}
.dc-name{font-size:10px;font-weight:500;color:var(--t1);margin-bottom:1px}
.dc-party{font-size:9px;color:var(--t3)}
.mic-active{border:1px solid var(--ng-green);background:var(--ng-green-f)}
.mic-muted{border:1px solid var(--b1);opacity:.6}
.ai-mod{display:flex;align-items:center;gap:6px;margin-bottom:12px;padding:8px;background:var(--s2);border-radius:8px}
.ai-mod-icon{font-size:14px}
.ai-mod-text{font-size:11px;color:var(--t2)}
.ai-mod-text strong{color:var(--ng-green-l)}
.qinput{display:flex;gap:6px}
.qinput input{flex:1;padding:9px 12px;background:var(--s2);border:1px solid var(--b1);border-radius:10px;color:var(--t1);font-family:var(--fb);font-size:12px;outline:none}
.qinput input:focus{border-color:var(--ng-green)}
.qinput button{padding:9px 14px;background:var(--ng-green);color:#fff;border:none;border-radius:10px;font-family:var(--fb);font-size:12px;font-weight:600;cursor:pointer}

/* KYC cards with citizen rating */
.kyc{background:var(--s1);border:1px solid var(--b1);border-radius:16px;margin-bottom:10px;overflow:hidden;cursor:pointer;transition:all .2s}
.kyc:hover{border-color:var(--b2);transform:translateY(-1px)}
.kyc-top{padding:14px;display:flex;gap:12px;align-items:flex-start}
.kyc-av{width:44px;height:44px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.kyc-party{display:inline-block;padding:2px 7px;border-radius:8px;font-size:9px;font-weight:600;margin-bottom:3px}
.apc{background:var(--blue-f);color:var(--blue)}
.pdp{background:var(--ng-green-f);color:var(--ng-green-l)}
.lp{background:var(--orange-f);color:var(--orange)}
.kyc-name{font-size:14px;font-weight:600;color:var(--t1);margin-bottom:2px}
.kyc-seat{font-size:11px;color:var(--t3)}
.kyc-checks{padding:10px 14px;border-top:1px solid var(--b1)}
.kc-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:7px}
.kc-row:last-child{margin-bottom:0}
.kc-label{font-size:12px;color:var(--t2)}
.kc-ok{font-size:12px;color:var(--ng-green-l);font-weight:500}
.kc-warn{font-size:12px;color:var(--orange);font-weight:500}
.kc-stars{color:var(--gold-l);font-size:11px}
/* Citizen rating tool */
.kyc-rate{padding:12px 14px;border-top:1px solid var(--b1);background:var(--ng-green-f)}
.kyc-rate-lbl{font-size:11px;font-weight:600;color:var(--ng-green-l);margin-bottom:8px}
.rate-metrics{display:flex;flex-direction:column;gap:5px}
.rm-row{display:flex;align-items:center;gap:8px}
.rm-label{font-size:11px;color:var(--t2);flex:1}
.rm-stars{display:flex;gap:3px}
.rm-star{font-size:12px;cursor:pointer;transition:transform .15s;color:var(--t4)}
.rm-star:hover,.rm-star.lit{color:var(--gold-l);transform:scale(1.2)}

/* Vote aggregation */
.vote-hero{margin:14px 18px;padding:16px;background:linear-gradient(135deg,#0a1020,#0f1a10);border:1px solid rgba(0,135,81,.2);border-radius:16px}
.vh-title{font-size:14px;font-weight:600;color:var(--t1);margin-bottom:3px}
.vh-sub{font-size:11px;color:var(--t2);margin-bottom:12px}
.vote-progress{margin-bottom:12px}
.vp-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px}
.vp-label{font-size:12px;color:var(--t2)}
.vp-pct{font-family:var(--fm);font-size:11px;color:var(--ng-green-l)}
.vp-track{height:8px;background:var(--s3);border-radius:4px;overflow:hidden}
.vp-fill{height:8px;border-radius:4px}
.vp-fill.apc-col{background:var(--blue)}
.vp-fill.pdp-col{background:var(--ng-green)}
.vp-fill.lp-col{background:var(--orange)}
.vp-label2{font-size:10px;color:var(--t3);margin-bottom:8px}
.pu-input{padding:10px 14px;background:var(--s2);border:1px solid var(--b1);border-radius:10px;display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;cursor:pointer;transition:all .2s}
.pu-input:hover{border-color:var(--ng-green)}
.pu-label{font-size:12px;color:var(--t2)}
.pu-status{font-size:10px;color:var(--ng-green-l);font-weight:500}

/* ═══════════════════════════════════════════
   S7 — TAX DASHBOARD (full rebuild)
═══════════════════════════════════════════ */
#s-tax{background:var(--ink);padding:0}
.tax-period-toggle{display:flex;gap:4px;padding:12px 18px 0}
.tpt{flex:1;padding:7px;background:var(--s2);border:1px solid var(--b1);border-radius:9px;font-size:11px;font-weight:500;color:var(--t3);cursor:pointer;text-align:center;transition:all .2s;font-family:var(--fb);border:none}
.tpt.active{background:var(--ng-green);color:#fff}

.tax-hero{margin:12px 18px;padding:20px;background:var(--s1);border:1px solid var(--b1);border-radius:16px;text-align:center}
.tax-label{font-size:11px;color:var(--t3);letter-spacing:.08em;text-transform:uppercase;font-weight:500;margin-bottom:6px}
.tax-total{font-family:var(--fd);font-size:34px;color:var(--ng-green-l);margin-bottom:3px;line-height:1}
.tax-tin{font-size:11px;color:var(--t3);font-family:var(--fm);margin-bottom:14px}
.tax-segs{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
.tseg{text-align:center;padding:10px;background:var(--s2);border-radius:9px}
.tseg-val{font-family:var(--fm);font-size:13px;font-weight:500;color:var(--t1)}
.tseg-key{font-size:10px;color:var(--t3);margin-top:2px}

/* IGR ranking */
.igr-card{margin:0 18px 14px;padding:14px;background:linear-gradient(135deg,var(--ng-green-f),rgba(0,135,81,.05));border:1px solid rgba(0,135,81,.25);border-radius:14px;display:flex;align-items:center;gap:12px}
.igr-icon{font-size:28px;flex-shrink:0}
.igr-text{flex:1}
.igr-title{font-size:13px;font-weight:600;color:var(--ng-green-l);margin-bottom:2px}
.igr-sub{font-size:11px;color:var(--t2);line-height:1.4}
.igr-rank{font-family:var(--fd);font-size:22px;color:var(--gold-l);font-weight:700}

/* Tax transaction ledger */
.ledger{margin:0 18px 14px;background:var(--s1);border:1px solid var(--b1);border-radius:16px;overflow:hidden}
.ledger-hd{padding:10px 14px;background:var(--s2);border-bottom:1px solid var(--b1);font-size:11px;font-weight:600;color:var(--t3);letter-spacing:.07em;text-transform:uppercase}
.tx-row{padding:12px 14px;display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--b1);cursor:pointer;transition:background .15s}
.tx-row:hover{background:var(--s2)}
.tx-row:last-child{border-bottom:none}
.tx-icon{width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0}
.tx-icon.paye{background:var(--blue-f);border:1px solid rgba(66,153,225,.3)}
.tx-icon.gig{background:var(--ng-green-f);border:1px solid rgba(0,135,81,.3)}
.tx-icon.vat{background:var(--orange-f);border:1px solid rgba(237,137,54,.3)}
.tx-body{flex:1}
.tx-title{font-size:12px;font-weight:500;color:var(--t1)}
.tx-sub{font-size:10px;color:var(--t3);margin-top:1px}
.tx-right{text-align:right}
.tx-amt{font-family:var(--fm);font-size:12px;color:var(--ng-green-l);font-weight:500}
.tx-date{font-size:10px;color:var(--t3);margin-top:1px}

/* Receipt modal */
.receipt-modal{position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:200;display:none;align-items:center;justify-content:center;padding:40px 20px}
.receipt-modal.open{display:flex}
.receipt{background:var(--s1);border:1px solid var(--b2);border-radius:20px;padding:24px;width:100%;max-width:320px;animation:fadeup .3s cubic-bezier(.34,1.3,.64,1)}
.receipt-header{text-align:center;margin-bottom:18px;padding-bottom:18px;border-bottom:1px dashed var(--b2)}
.receipt-logo{font-family:var(--fd);font-size:22px;color:var(--ng-green-l);margin-bottom:2px}
.receipt-sub{font-size:11px;color:var(--t3);letter-spacing:.1em;text-transform:uppercase}
.receipt-amt{font-family:var(--fd);font-size:32px;color:var(--t1);margin:12px 0 0;font-weight:700}
.receipt-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;font-size:12px}
.receipt-row .k{color:var(--t3)}
.receipt-row .v{color:var(--t1);font-family:var(--fm);font-size:11px}
.receipt-close{margin-top:16px;width:100%;padding:11px;background:var(--s2);border:1px solid var(--b1);border-radius:10px;color:var(--t2);font-family:var(--fb);font-size:13px;cursor:pointer}

/* Freedom link */
.fl-card{margin:0 18px 14px;padding:14px;background:var(--ng-green-f);border:1px solid rgba(0,135,81,.25);border-radius:14px;display:flex;gap:12px;align-items:center;cursor:pointer}
.fl-icon{font-size:24px;flex-shrink:0}
.fl-text{flex:1}
.fl-title{font-size:13px;font-weight:600;color:var(--ng-green-l);margin-bottom:2px}
.fl-body{font-size:11px;color:var(--t2);line-height:1.4}
.fl-arr{color:var(--ng-green-l);font-size:16px}

/* Destination bars */
.dest-card{margin:0 18px 16px;background:var(--s1);border:1px solid var(--b1);border-radius:14px;overflow:hidden}
.dest-hd{padding:10px 14px;background:var(--s2);border-bottom:1px solid var(--b1);font-size:11px;font-weight:600;color:var(--t3);letter-spacing:.07em;text-transform:uppercase}
.dest-row{padding:12px 14px;border-bottom:1px solid var(--b1)}
.dest-row:last-child{border-bottom:none}
.dest-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:5px}
.dest-label{font-size:12px;color:var(--t2)}
.dest-amt{font-family:var(--fm);font-size:11px;color:var(--ng-green-l)}
.dest-track{height:5px;background:var(--s3);border-radius:3px}
.dest-fill{height:5px;border-radius:3px;background:var(--ng-green)}

/* Accountability prompt */
.acct-prompt{margin:0 18px 16px;padding:14px;background:var(--s2);border:1px solid var(--b1);border-radius:12px}
.ap-text{font-size:12px;color:var(--t2);line-height:1.6}
.ap-link{color:var(--ng-green-l);cursor:pointer;font-weight:500}

/* ═══════════════════════════════════════════
   S8 — LEGAL RIGHTS (new screen)
═══════════════════════════════════════════ */
#s-legal{background:var(--ink);padding:0}
.legal-hero{padding:18px;background:linear-gradient(180deg,#0f0d1a,var(--ink));border-bottom:1px solid var(--b1)}
.legal-voice{margin:14px 18px;padding:14px;background:var(--s1);border:1px solid var(--b1);border-radius:14px}
.lv-q{font-size:13px;font-style:italic;color:var(--t2);margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid var(--b1);line-height:1.5}
.lv-response{display:flex;gap:10px;align-items:flex-start}
.lv-ai{width:30px;height:30px;border-radius:8px;background:var(--ng-green);display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0}
.lv-answer{flex:1;font-size:13px;color:var(--t1);line-height:1.6}
.lv-answer em{color:var(--ng-green-l);font-style:normal}
.lv-citation{font-size:11px;color:var(--t3);margin-top:6px;padding-top:6px;border-top:1px solid var(--b1);font-family:var(--fm)}
.rights-cats{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:0 18px;margin-bottom:16px}
.rcat2{padding:14px;background:var(--s1);border:1px solid var(--b1);border-radius:12px;cursor:pointer;transition:all .2s}
.rcat2:hover{background:var(--s2);border-color:var(--b2);transform:translateY(-1px)}
.rcat2-icon{font-size:20px;margin-bottom:5px}
.rcat2-label{font-size:12px;font-weight:600;color:var(--t1);margin-bottom:2px}
.rcat2-sub{font-size:11px;color:var(--t3)}
.popular-q{margin:0 18px 16px;background:var(--s1);border:1px solid var(--b1);border-radius:14px;overflow:hidden}
.pq-row{padding:12px 14px;border-bottom:1px solid var(--b1);cursor:pointer;transition:background .15s;display:flex;align-items:center;gap:10px}
.pq-row:hover{background:var(--s2)}
.pq-row:last-child{border-bottom:none}
.pq-icon{font-size:14px;width:28px;flex-shrink:0;text-align:center}
.pq-text{flex:1;font-size:12px;color:var(--t2)}
.pq-arr{font-size:12px;color:var(--t4)}

/* ═══════════════════════════════════════════
   S9 — BUDGET ANALYSIS (new screen)
═══════════════════════════════════════════ */
#s-budget{background:var(--ink);padding:0}
.budget-hero{padding:18px;background:linear-gradient(180deg,#0f1a0a,var(--ink));border-bottom:1px solid var(--b1)}
.budget-year-toggle{display:flex;gap:4px;margin-top:12px}
.byt{flex:1;padding:6px;background:var(--s2);border:none;border-radius:8px;font-size:11px;color:var(--t3);cursor:pointer;text-align:center;transition:all .2s;font-family:var(--fb);font-weight:500}
.byt.active{background:var(--ng-green);color:#fff}
.budget-total-card{margin:14px 18px;padding:16px;background:var(--s1);border:1px solid var(--b1);border-radius:14px;text-align:center}
.btc-label{font-size:11px;color:var(--t3);letter-spacing:.07em;text-transform:uppercase;margin-bottom:5px}
.btc-val{font-family:var(--fd);font-size:32px;color:var(--t1);margin-bottom:3px}
.btc-change{font-size:12px;color:var(--ng-green-l)}
.btc-change.neg{color:var(--red)}
.sector-breakdown{margin:0 18px 14px;background:var(--s1);border:1px solid var(--b1);border-radius:14px;overflow:hidden}
.sb-hd{padding:10px 14px;background:var(--s2);border-bottom:1px solid var(--b1);font-size:11px;font-weight:600;color:var(--t3);letter-spacing:.07em;text-transform:uppercase}
.sb-row{padding:12px 14px;border-bottom:1px solid var(--b1);display:flex;align-items:center;gap:10px}
.sb-row:last-child{border-bottom:none}
.sb-color{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.sb-label{flex:1;font-size:12px;color:var(--t2)}
.sb-bar-wrap{flex:2;height:5px;background:var(--s3);border-radius:3px}
.sb-bar{height:5px;border-radius:3px}
.sb-pct{font-family:var(--fm);font-size:11px;color:var(--t2);width:36px;text-align:right}
.global-compare{margin:0 18px 14px;padding:14px;background:var(--s1);border:1px solid var(--b1);border-radius:14px}
.gc-title{font-size:12px;font-weight:600;color:var(--t2);margin-bottom:10px;letter-spacing:.06em;text-transform:uppercase}
.gc-row{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.gc-flag{font-size:14px;flex-shrink:0;width:20px}
.gc-country{flex:1;font-size:12px;color:var(--t2)}
